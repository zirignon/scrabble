DATABASE_URL="postgresql://scrabble:scrabble@localhost:5432/scrabble"

# Connexion directe (sans pooler) utilisée par Prisma Migrate. En local,
# identique à DATABASE_URL. Sur un hébergeur avec pooler (ex. Neon), utilisez
# la chaîne de connexion "pooled" pour DATABASE_URL et la chaîne "directe"
# (sans "-pooler" dans le nom d'hôte) pour DIRECT_URL.
DIRECT_URL="postgresql://scrabble:scrabble@localhost:5432/scrabble"

# Secret used to sign session cookies (JWT). Generate a long random value in production.
SESSION_SECRET="change-me"

# Clé API Resend (https://resend.com), nécessaire à l'envoi d'emails : code de
# connexion à deux facteurs (obligatoire à chaque connexion d'un compte
# ADMIN/ORGANIZER/REFEREE) et réinitialisation de mot de passe. Sans elle,
# AUCUN compte staff ne peut se connecter — voir le README (section
# Déploiement) avant de mettre en production.
RESEND_API_KEY="change-me"
