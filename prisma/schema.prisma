// Schema Prisma - Plateforme de gestion de tournois de Scrabble (classique + duplicate)

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL peut pointer vers une connexion "pooled" (ex. PgBouncer chez
// Neon) pour les requêtes de l'application côté serverless ; DIRECT_URL doit
// pointer vers une connexion directe (sans pooler), seule capable de tenir
// le verrou de session dont `prisma migrate deploy` a besoin. En local, les
// deux valeurs sont identiques (une seule instance Postgres, sans pooler).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  REFEREE
  PLAYER
}

enum TournamentType {
  CLASSIC
  DUPLICATE
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ClassicFormat {
  ROUND_ROBIN
  SWISS
  GROUPS
  KNOCKOUT
  // "Combiné" : phase de poules (qualification) suivie d'une phase suisse
  // entre les qualifiés, elle-même suivie d'une phase finale à élimination
  // directe optionnelle (voir finalPhaseEnabled) — comme GROUPS, mais avec
  // un système suisse à la place du passage direct au tableau final.
  COMBINED
}

// Détermine comment départager les joueurs/équipes pour l'appariement de la
// toute première ronde suisse — le classement (0 point partout) ne permet
// pas encore de les différencier à ce stade, contrairement aux rondes
// suivantes. Sans effet une fois la ronde 1 générée.
enum SwissSeeding {
  RANDOM
  RATING
}

// Mode de l'affichage grand écran : par défaut il alterne automatiquement
// entre le classement et la ronde/partie en cours (AUTO) ; l'organisateur
// peut figer l'affichage sur l'une des deux vues (STANDINGS/CURRENT) pour
// éviter que l'écran ne bascule pendant un temps fort (ex. fin de partie).
enum TournamentDisplayMode {
  AUTO
  STANDINGS
  CURRENT
}

// Formule de tournoi duplicate (FISF/FFSc, §3.8) : détermine les règles de
// jeu propres à la partie (nombre de lettres tirées, primes de Scrabble
// applicables). Le jeu du joker (Partie Joker) ne change pas le calcul du
// score en lui-même : une lettre blanche est simplement signalée par une
// minuscule dans le mot saisi. Indépendante du rythme (voir DuplicateRythme)
// qui détermine, lui, la durée du chronomètre.
enum DuplicateFormula {
  NORMALE
  JOKER
  SEPT_SUR_HUIT
  SEPT_SUR_HUIT_JOKER
  SEPT_ET_HUIT
  SEPT_ET_HUIT_JOKER
}

// Rythme de jeu (FISF/FFSc, §1.3) : détermine la durée par défaut du
// chronomètre de partie, indépendamment de la formule. Chaque rythme a
// aussi un repère d'alerte avant la fin du temps (30 ou 20 secondes selon
// le rythme, cf. l'annonce "trente (ou vingt) secondes" du §3.3) ; seul le
// rythme Blitz bénéficie par ailleurs d'un quota d'avertissements gratuits
// élargi (§5.9).
enum DuplicateRythme {
  NORMAL
  SEMI_NORMAL
  SEMI_RAPIDE
  SEMI_BLITZ
  BLITZ
}

// Pénalité d'arbitrage appliquée à un coup joué (saisie coup par coup) :
// - AVERTISSEMENT : aucun effet chiffré direct sur le coup, mais chaque
//   groupe complet d'avertissements dans la même partie (4 en temps normal,
//   6 en Blitz) coûte 5 points au joueur sur cette partie.
// - PENALITE : retire 5 points au score de la partie, en plus des points
//   du coup lui-même.
// - ZERO : le coup concerné rapporte 0 point, quels que soient les points
//   saisis.
enum DuplicateMovePenalty {
  AVERTISSEMENT
  PENALITE
  ZERO
}

enum MatchStatus {
  SCHEDULED
  PLAYED
  FORFEIT_HOME
  FORFEIT_AWAY
  // Les deux camps sont absents (à distinguer d'un forfait simple, où
  // l'adversaire présent est crédité d'une victoire) : les deux perdent 0
  // point, comme un forfait individuel, plutôt qu'un match nul joué (2 pts
  // chacun) — voir computeStandingsFromMatches.
  FORFEIT_BOTH
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(PLAYER)
  // Incrémenté lors d'un changement de rôle ou de mot de passe afin
  // d'invalider immédiatement tous les JWT déjà émis pour ce compte.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())

  player                Player?
  tournaments           Tournament[] @relation("Organizer")
  auditLogs             AuditLog[]
  twoFactorChallenges   TwoFactorChallenge[]
  passwordResetTokens   PasswordResetToken[]
}

// Code à usage unique envoyé par email pour la double authentification,
// exigée à la connexion pour les comptes ADMIN/ORGANIZER/REFEREE (voir
// STAFF_ROLES) — les comptes PLAYER ne passent jamais par cette étape.
model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Hash du code à 6 chiffres (jamais stocké en clair), voir hashOtpCode.
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Jeton "mot de passe oublié" envoyé par email (lien de réinitialisation en
// libre-service) — distinct de TwoFactorChallenge : un jeton long et
// aléatoire glissé dans une URL plutôt qu'un code à 6 chiffres saisi à la
// main, avec une durée de vie plus longue (1h) adaptée à un email qu'on peut
// ouvrir en différé.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Hash du jeton (jamais stocké en clair), voir hashResetToken.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Historique minimal des opérations sensibles. Les données métier restent
// supprimables ; la trace conserve simplement l'identifiant de leur cible.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model Club {
  id          String   @id @default(cuid())
  name        String   @unique
  // Code court du club tel qu'utilisé dans les fichiers d'import fédéraux
  // (ex. "ISC", "Z00"). Sert de clé pour retrouver/mettre à jour un club
  // importé sans dépendre de son nom (modifiable ensuite par l'organisateur).
  code        String?  @unique
  city        String?
  federation  String?
  players     Player[]
}

model Player {
  id            String  @id @default(cuid())
  userId        String? @unique
  user          User?   @relation(fields: [userId], references: [id])
  firstName     String
  lastName      String
  clubId        String?
  club          Club?   @relation(fields: [clubId], references: [id])
  licenseNumber String? @unique
  category      String?
  // Série duplicate (ex. "1A".."7"), texte libre, le barème variant d'une
  // fédération à l'autre.
  classification String?
  // Série classique (ex. "J"/"C"/"B"/"A"), distincte de la série duplicate
  // ci-dessus : un joueur peut avoir les deux à la fois.
  classificationClassic String?
  // Coefficient associé à la série classique (ex. 40, 20, 16...).
  coefficientClassic     Int?
  // Indices de classement numériques (type Elo), un par format.
  eloDuplicate Int?
  eloClassic   Int?
  // Code nationalité (ex. "CI", "FR"), tel qu'affiché sur les feuilles de
  // classement officielles.
  nationality    String?
  // Fédération d'affiliation du joueur (ex. "FR", "QC") : peut différer de
  // celle du club (cas des clubs "hors fédération" ou multi-pays).
  federation     String?

  createdAt DateTime @default(now())

  registrations    Registration[]
  homeMatches      Match[]           @relation("HomePlayer")
  awayMatches      Match[]           @relation("AwayPlayer")
  duplicateResults DuplicateResult[]
  duplicateMoves   DuplicateMove[]
  teamMemberships  TeamMember[]
  poolMemberships  PoolMember[]
}

model Tournament {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  type         TournamentType
  format       ClassicFormat?
  isTeamEvent  Boolean           @default(false)
  qualifiersPerPool Int          @default(2)
  // Phase finale à élimination directe optionnelle après un round-robin ou
  // un système suisse (indépendante de qualifiersPerPool, qui ne concerne
  // que le format poules) : activable/désactivable, avec le nombre de
  // qualifiés (au classement général, tous confondus) configurable.
  finalPhaseEnabled     Boolean   @default(false)
  finalPhaseQualifiers  Int       @default(4)
  // Nombre de rondes suisses (format SWISS uniquement) que l'organisateur
  // prévoit de jouer avant de passer à la phase finale — laissé à null,
  // les rondes se génèrent une par une sans limite prédéfinie comme
  // auparavant (l'organisateur décide lui-même quand s'arrêter).
  swissRoundsCount      Int?
  // Autorise volontairement les revanches (deux entrants déjà opposés lors
  // d'une ronde antérieure) à partir de cette ronde suisse incluse — courant
  // en fin de tournoi quand le vivier d'adversaires inédits se resserre.
  // À partir de cette ronde, l'appariement suit strictement le classement
  // sans chercher à éviter les revanches, mais une même paire ne se
  // rencontre jamais plus de deux fois au total (une seule revanche
  // possible, jamais une 3e fois). Laissé à null (par défaut) : aucune
  // revanche volontaire, seulement en dernier recours si generateSwissRound
  // n'a aucun adversaire inédit disponible pour un entrant donné. Pour un
  // tournoi COMBINED, la ronde se compte au sein de la phase suisse
  // elle-même (voir "Ronde suisse N"), pas dans la numérotation globale du
  // tournoi qui inclut les poules.
  allowRematchesFromRound Int?
  // Méthode d'appariement de la toute première ronde suisse : tirage au
  // sort (par défaut) ou classement par Elo classique décroissant. Laisse
  // le choix à l'organisateur, qui peut préférer l'un ou l'autre selon le
  // tournoi (amical vs compétitif, Elo fiable ou non).
  swissSeeding          SwissSeeding @default(RANDOM)
  // Match de classement pour la 3e place, optionnel, entre les deux
  // perdants de demi-finale — s'applique à tout tableau à élimination
  // directe (KNOCKOUT, phase finale de poules, ou phase finale générée
  // depuis le classement général en round-robin/suisse).
  thirdPlaceMatchEnabled Boolean  @default(false)
  // Format des confrontations de tout tableau à élimination directe
  // individuel (KNOCKOUT, phase finale de poules, ou phase finale générée
  // depuis un classement général/suisse) : au lieu d'un match sec, chaque
  // confrontation se joue en 2 manches (le joueur qui débute alterne d'une
  // manche à l'autre, voir Match.homeStarts) puis, si chacun a gagné une
  // manche, une belle décisive — jamais plus de 3 matchs par confrontation.
  // Sans effet sur le match pour la 3e place (toujours en un seul match) ni
  // sur les tournois par équipes. Voir Round.knockoutLeg/knockoutStage.
  knockoutTwoLegs        Boolean  @default(false)
  // Rondes de round-robin (format ROUND_ROBIN, hors poules) pas encore
  // matérialisées en base — révélées une par une au fur et à mesure que la
  // ronde en cours se termine, pour que l'affichage public suive la partie
  // réellement en train de se jouer plutôt que de sauter direct à la
  // dernière ronde du calendrier. Tableau de rondes (chacune un tableau
  // d'appariements {home, away}), dans l'ordre où elles doivent être
  // révélées ; null/vide une fois tout le calendrier matérialisé.
  pendingRoundRobinSchedule Json?
  duplicateFormula DuplicateFormula?
  duplicateRythme  DuplicateRythme?
  description  String?
  venue        String?
  startDate    DateTime
  endDate      DateTime?
  status       TournamentStatus  @default(DRAFT)
  displayMode  TournamentDisplayMode @default(AUTO)
  organizerId  String
  organizer    User              @relation("Organizer", fields: [organizerId], references: [id])
  createdAt    DateTime          @default(now())

  registrations Registration[]
  rounds        Round[]
  games         Game[]
  teams         Team[]
  pools         Pool[]
}

model Registration {
  id           String             @id @default(cuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player             @relation(fields: [playerId], references: [id])
  status       RegistrationStatus @default(CONFIRMED)
  createdAt    DateTime           @default(now())

  @@unique([tournamentId, playerId])
}

// ---- Tournois par équipes (classique et duplicate) ----

// Une équipe existe dans le cadre d'un tournoi donné. En classique, chaque
// membre occupe un échiquier (board) fixe utilisé pour apparier les équipes
// lors de la génération des rondes. En duplicate, l'équipe n'est qu'un
// regroupement de joueurs : leurs scores sont cumulés pour le classement
// par équipes, sans notion d'échiquier.
model Team {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime @default(now())
  poolId       String?
  pool         Pool?      @relation(fields: [poolId], references: [id], onDelete: SetNull)

  members     TeamMember[]
  homeMatches Match[]      @relation("HomeTeam")
  awayMatches Match[]      @relation("AwayTeam")

  @@unique([tournamentId, name])
}

model TeamMember {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  board    Int

  @@unique([teamId, playerId])
  @@unique([teamId, board])
}

// Une poule regroupe des joueurs (mode individuel) ou des équipes (mode
// équipes) pour un tournoi classique au format "Poules" : chaque poule
// joue son propre round-robin interne, et son classement est calculé
// séparément.
model Pool {
  id           String @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime @default(now())

  members PoolMember[]
  teams   Team[]
  matches Match[]

  // Voir le commentaire équivalent sur Tournament.pendingRoundRobinSchedule
  // — chaque poule joue son propre round-robin interne, donc son propre
  // calendrier en attente.
  pendingRoundRobinSchedule Json?

  @@unique([tournamentId, name])
}

model PoolMember {
  id       String @id @default(cuid())
  poolId   String
  pool     Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([poolId, playerId])
}

// ---- Scrabble classique ----

model Round {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int
  playedAt     DateTime?
  // Marque les rondes qui ne font plus partie de la phase principale
  // (poules, ou round-robin/suisse) — élimination directe (voir
  // finalPhaseEnabled sur Tournament) la plupart du temps, mais aussi la
  // phase suisse d'un tournoi COMBINED (voir isSwissPhase ci-dessous). Ces
  // rondes n'ont pas de poolId pour les départager.
  isFinalPhase Boolean    @default(false)
  // Ne s'applique qu'aux tournois au format COMBINED (poules puis suisse
  // puis, en option, élimination directe) : distingue, parmi les rondes
  // isFinalPhase, celles de la sous-phase suisse (isSwissPhase = true) de
  // celles du tableau à élimination directe optionnel qui la suit
  // (isSwissPhase = false, comme toute ronde de phase finale classique).
  isSwissPhase Boolean    @default(false)
  // Ne s'applique qu'aux tableaux à élimination directe individuels quand
  // Tournament.knockoutTwoLegs est actif : 1 = manche aller, 2 = manche
  // retour (mêmes confrontations que la manche aller), 3 = belle (rejoue
  // uniquement les confrontations où chaque camp a gagné une manche). Null
  // pour toute ronde qui ne fait pas partie d'un tel tableau (y compris un
  // tableau à élimination directe classique en un seul match).
  knockoutLeg   Int?
  // Regroupe les rondes (aller/retour/belle) d'un même tour du tableau —
  // incrémenté à chaque nouveau tour, stable au sein d'un même tour. Permet
  // de retrouver toutes les rondes d'un tour donné pour dépouiller le
  // vainqueur de chaque confrontation avant de générer le tour suivant.
  // Toujours null si knockoutLeg l'est aussi.
  knockoutStage Int?

  matches Match[]

  @@unique([tournamentId, number])
}

model Match {
  id           String      @id @default(cuid())
  roundId      String
  round        Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  table        Int?
  homePlayerId String?
  homePlayer   Player?     @relation("HomePlayer", fields: [homePlayerId], references: [id])
  awayPlayerId String?
  awayPlayer   Player?     @relation("AwayPlayer", fields: [awayPlayerId], references: [id])
  homeTeamId   String?
  homeTeam     Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId   String?
  awayTeam     Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  poolId       String?
  pool         Pool?       @relation(fields: [poolId], references: [id], onDelete: SetNull)
  homeScore    Int?
  awayScore    Int?
  status       MatchStatus @default(SCHEDULED)
  isBye        Boolean     @default(false)
  // Marque le(s) match(s) de classement pour la 3e place (perdants des deux
  // demi-finales), généré dans la même ronde que la finale — permet de le
  // distinguer du match principal pour l'étiquetage du tour (voir
  // countKnockoutEntrants/getKnockoutStageLabel) et son affichage à part.
  isThirdPlace Boolean     @default(false)
  // Par équipes uniquement : indique si c'est le joueur "domicile" (colonne
  // de gauche) qui débute la partie sur cet échiquier, ou son adversaire
  // "extérieur" — alterné à chaque échiquier au sein d'une même
  // confrontation (voir createTeamEncounterMatches) pour équilibrer les
  // débuts de partie entre les deux équipes, sans jamais toucher
  // homeTeamId/awayTeamId (qui doivent rester stables sur toute la
  // confrontation pour le calcul du classement par équipes). N'affecte que
  // l'ordre d'affichage ; toujours vrai (non pertinent) hors tournoi par
  // équipes.
  homeStarts   Boolean     @default(true)
}

// ---- Scrabble duplicate ----

model Game {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int
  playedAt     DateTime?
  top          Int?

  // Compte à rebours unique de la partie (duplicate) : tous les joueurs
  // cherchent leur mot sur le même tirage pendant ce temps, démarré/mis en
  // pause par l'arbitre. timerRemainingSeconds est le temps restant "figé"
  // à la dernière pause/réinitialisation ; timerStartedAt marque le
  // dernier démarrage, pour calculer le temps écoulé pendant que ça tourne.
  timerDurationSeconds  Int       @default(180)
  timerRemainingSeconds Int?
  timerRunning          Boolean   @default(false)
  timerStartedAt        DateTime?

  // Tirage validé par l'arbitre pour le tour en cours, avant que le mot ne
  // soit décidé : projeté tel quel (grille complète) sur l'affichage grand
  // écran dès sa validation, pour que les joueurs le voient avant le
  // démarrage du chrono. Effacé dès que le coup de référence correspondant
  // est enregistré (le reliquat prend alors le relais pour l'affichage).
  pendingRack String?

  results        DuplicateResult[]
  moves          DuplicateMove[]
  referenceMoves ReferenceMove[]

  @@unique([tournamentId, number])
}

// Grille officielle de la partie (arbitre) : le "coup de référence" joué
// à chaque tour, contre lequel les propositions de tous les joueurs sont
// comparées. Distinct de DuplicateMove (le coup par coup propre à chaque
// joueur) — c'est cette grille unique par partie qui est reconstruite et
// projetée sur l'affichage grand écran.
model ReferenceMove {
  id         String  @id @default(cuid())
  gameId     String
  game       Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  turnNumber Int
  row        Int
  col        Int
  direction  String
  word       String?
  points     Int     @default(0)
  isPass     Boolean @default(false)
  // Tirage annoncé pour ce tour (commun à tous les joueurs en duplicate) :
  // saisi par l'arbitre, projeté automatiquement sur l'affichage grand
  // écran dès qu'il est renseigné, avant même que le mot ne le soit.
  rack       String?

  @@unique([gameId, turnNumber])
}

model DuplicateResult {
  id       String @id @default(cuid())
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  score    Int
  penalty  Int    @default(0)

  @@unique([gameId, playerId])
}

// Saisie coup par coup (détail arbitrage) : chaque coup joué par un joueur
// dans une partie duplicate. Le score total d'un joueur pour la partie
// (DuplicateResult.score) est recalculé comme la somme de ses coups dès
// qu'au moins un coup est saisi.
model DuplicateMove {
  id              String   @id @default(cuid())
  gameId          String
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id])
  turnNumber      Int
  rack            String?
  word            String?
  points          Int      @default(0)
  top             Int?
  isPass          Boolean  @default(false)
  penaltyType     DuplicateMovePenalty?

  // Un coup "solo" (seul meilleur score du tour) détecté par l'algorithme
  // ne rapporte ses +10 points (règlement FISF §3.5) qu'après validation
  // explicite de l'arbitre — voir toggleSoloConfirmationAction.
  soloConfirmed   Boolean  @default(false)

  @@unique([gameId, playerId, turnNumber])
}

// Liste de mots valides (fournie par l'organisateur, ex. import de l'ODS
// dont il possède les droits) utilisée pour signaler les mots joués non
// reconnus lors de la saisie coup par coup. Stockée en majuscules sans
// accents (forme jouable au Scrabble).
model DictionaryWord {
  id   String @id @default(cuid())
  word String @unique
}
