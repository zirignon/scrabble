// Schema Prisma - Plateforme de gestion de tournois de Scrabble (classique + duplicate)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  REFEREE
  PLAYER
}

enum TournamentType {
  CLASSIC
  DUPLICATE
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ClassicFormat {
  ROUND_ROBIN
  SWISS
  GROUPS
  KNOCKOUT
}

enum MatchStatus {
  SCHEDULED
  PLAYED
  FORFEIT_HOME
  FORFEIT_AWAY
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())

  player      Player?
  tournaments Tournament[] @relation("Organizer")
}

model Club {
  id          String   @id @default(cuid())
  name        String   @unique
  city        String?
  federation  String?
  players     Player[]
}

model Player {
  id            String  @id @default(cuid())
  userId        String? @unique
  user          User?   @relation(fields: [userId], references: [id])
  firstName     String
  lastName      String
  clubId        String?
  club          Club?   @relation(fields: [clubId], references: [id])
  licenseNumber String?
  category      String?

  createdAt DateTime @default(now())

  registrations    Registration[]
  homeMatches      Match[]           @relation("HomePlayer")
  awayMatches      Match[]           @relation("AwayPlayer")
  duplicateResults DuplicateResult[]
  duplicateMoves   DuplicateMove[]
  teamMemberships  TeamMember[]
  poolMemberships  PoolMember[]
}

model Tournament {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  type         TournamentType
  format       ClassicFormat?
  isTeamEvent  Boolean           @default(false)
  description  String?
  venue        String?
  startDate    DateTime
  endDate      DateTime?
  status       TournamentStatus  @default(DRAFT)
  organizerId  String
  organizer    User              @relation("Organizer", fields: [organizerId], references: [id])
  createdAt    DateTime          @default(now())

  registrations Registration[]
  rounds        Round[]
  games         Game[]
  teams         Team[]
  pools         Pool[]
}

model Registration {
  id           String             @id @default(cuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id])
  playerId     String
  player       Player             @relation(fields: [playerId], references: [id])
  status       RegistrationStatus @default(CONFIRMED)
  createdAt    DateTime           @default(now())

  @@unique([tournamentId, playerId])
}

// ---- Tournois par équipes (classique et duplicate) ----

// Une équipe existe dans le cadre d'un tournoi donné. En classique, chaque
// membre occupe un échiquier (board) fixe utilisé pour apparier les équipes
// lors de la génération des rondes. En duplicate, l'équipe n'est qu'un
// regroupement de joueurs : leurs scores sont cumulés pour le classement
// par équipes, sans notion d'échiquier.
model Team {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  name         String
  createdAt    DateTime @default(now())
  poolId       String?
  pool         Pool?      @relation(fields: [poolId], references: [id], onDelete: SetNull)

  members     TeamMember[]
  homeMatches Match[]      @relation("HomeTeam")
  awayMatches Match[]      @relation("AwayTeam")

  @@unique([tournamentId, name])
}

model TeamMember {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  board    Int

  @@unique([teamId, playerId])
  @@unique([teamId, board])
}

// Une poule regroupe des joueurs (mode individuel) ou des équipes (mode
// équipes) pour un tournoi classique au format "Poules" : chaque poule
// joue son propre round-robin interne, et son classement est calculé
// séparément.
model Pool {
  id           String @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  name         String
  createdAt    DateTime @default(now())

  members PoolMember[]
  teams   Team[]
  matches Match[]

  @@unique([tournamentId, name])
}

model PoolMember {
  id       String @id @default(cuid())
  poolId   String
  pool     Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([poolId, playerId])
}

// ---- Scrabble classique ----

model Round {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  number       Int
  playedAt     DateTime?

  matches Match[]

  @@unique([tournamentId, number])
}

model Match {
  id           String      @id @default(cuid())
  roundId      String
  round        Round       @relation(fields: [roundId], references: [id])
  table        Int?
  homePlayerId String?
  homePlayer   Player?     @relation("HomePlayer", fields: [homePlayerId], references: [id])
  awayPlayerId String?
  awayPlayer   Player?     @relation("AwayPlayer", fields: [awayPlayerId], references: [id])
  homeTeamId   String?
  homeTeam     Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String?
  awayTeam     Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  poolId       String?
  pool         Pool?       @relation(fields: [poolId], references: [id])
  homeScore    Int?
  awayScore    Int?
  status       MatchStatus @default(SCHEDULED)
  isBye        Boolean     @default(false)
}

// ---- Scrabble duplicate ----

model Game {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  number       Int
  playedAt     DateTime?
  top          Int?

  results DuplicateResult[]
  moves   DuplicateMove[]

  @@unique([tournamentId, number])
}

model DuplicateResult {
  id       String @id @default(cuid())
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id])
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  score    Int
  penalty  Int    @default(0)

  @@unique([gameId, playerId])
}

// Saisie coup par coup (détail arbitrage) : chaque coup joué par un joueur
// dans une partie duplicate. Le score total d'un joueur pour la partie
// (DuplicateResult.score) est recalculé comme la somme de ses coups dès
// qu'au moins un coup est saisi.
model DuplicateMove {
  id         String  @id @default(cuid())
  gameId     String
  game       Game    @relation(fields: [gameId], references: [id])
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id])
  turnNumber Int
  rack       String?
  word       String?
  points     Int     @default(0)
  top        Int?
  isPass     Boolean @default(false)

  @@unique([gameId, playerId, turnNumber])
}
